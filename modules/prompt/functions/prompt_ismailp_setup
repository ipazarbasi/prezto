# A simple theme that displays relevant, contextual information.
#
# Authors:
#   Sorin Ionescu <sorin.ionescu@gmail.com>
#   Ismail Pazarbasi <ismail.pazarbasi@gmail.com>
#
# Customized for myself; Ismail Pazarbasi
#
# Cost model: everything except dirtiness is read from files or shell state, so
# prompt redraws never fork -- ESC/i in vi mode is free. The one expensive bit
# is a single `git status --porcelain=v2` per command, which also yields branch
# and ahead/behind, so it replaces prezto's multi-fork git-info.
#

pmodload 'helper'

# Fish-style $PWD: parents shortened to one char, leaf kept whole.
function prompt_ismailp_pwd {
  local p=${PWD/#$HOME/\~} out=""
  local -a parts=( ${(s:/:)p} )
  local n=$#parts i
  (( n == 0 )) && { _prompt_ismailp_pwd=/; return }
  [[ $p != \~* && $p == /* ]] && out="/"
  for (( i = 1; i < n; i++ )); do
    [[ -z $parts[i] ]] && continue
    if [[ $parts[i] == \~ ]]; then out+="~/"; else out+="${parts[i][1,1]}/"; fi
  done
  _prompt_ismailp_pwd=$out${parts[n]}
}

# Locate $GIT_DIR by walking up. No forks; handles linked worktrees.
function prompt_ismailp_gitdir {
  local d=$PWD
  _prompt_ismailp_gd=
  while [[ -n $d && ! -e $d/.git ]]; do d=${d%/*}; done
  [[ -n $d ]] || return 1
  local gd=$d/.git
  [[ -f $gd ]] && gd=${"$(<$gd)"#gitdir: }
  [[ -d $gd ]] || return 1
  _prompt_ismailp_gd=$gd
}

function prompt_ismailp_git {
  _prompt_ismailp_git=''
  prompt_ismailp_gitdir || return

  local gd=$_prompt_ismailp_gd action='' stash=''

  # In-progress operations: file tests only.
  if   [[ -e $gd/MERGE_HEAD ]];                            then action='merge'
  elif [[ -d $gd/rebase-merge || -d $gd/rebase-apply ]];   then action='rebase'
  elif [[ -e $gd/CHERRY_PICK_HEAD ]];                      then action='cherry-pick'
  elif [[ -e $gd/REVERT_HEAD ]];                           then action='revert'
  elif [[ -f $gd/BISECT_LOG ]];                            then action='bisect'
  fi

  # The stash reflog lives in the common dir, shared by every worktree.
  local common=$gd
  [[ -r $gd/commondir ]] && common=$gd/${"$(<$gd/commondir)"}
  if [[ -r $common/logs/refs/stash ]]; then
    local -a entries=( ${(f)"$(<$common/logs/refs/stash)"} )
    (( $#entries )) && stash=$#entries
  fi

  # The single fork per command. porcelain=v2 --branch also carries the branch
  # name and ahead/behind, so one call covers everything git must answer.
  local -a lines
  lines=( ${(f)"$(git status --porcelain=v2 --branch --ignore-submodules=all 2>/dev/null)"} )

  local head='' ab='' line xy
  local -i staged=0 modified=0 deleted=0 renamed=0 unmerged=0 untracked=0
  for line in $lines; do
    case $line in
      '# branch.head '*) head=${line#\# branch.head } ;;
      '# branch.ab '*)   ab=${line#\# branch.ab } ;;
      '1 '*|'2 '*)
        xy=${${(s: :)line}[2]}
        [[ ${xy[1]} == [MADRC] ]] && staged=1
        case ${xy[2]} in
          M) modified=1 ;;
          D) deleted=1 ;;
          R|C) renamed=1 ;;
        esac
        [[ $line == '2 '* ]] && renamed=1
        ;;
      'u '*) unmerged=1 ;;
      '?'*)  untracked=1 ;;
    esac
  done

  local out=''
  if [[ -n $head ]]; then
    if [[ $head == '(detached)' ]]; then
      local oid
      for line in $lines; do
        [[ $line == '# branch.oid '* ]] && oid=${line#\# branch.oid }
      done
      out+=" %F{red}${oid[1,8]}%f"
    else
      out+=" %F{green}${head//\%/%%}%f"
    fi
  fi
  [[ -n $action ]] && out+=" %B%F{yellow}${action}%f%b"
  if [[ -n $ab ]]; then
    local -a counts=( ${(s: :)ab} )
    [[ ${counts[1]} != '+0' ]] && out+=" %B%F{yellow}⬆%f%b"
    [[ ${counts[2]} != '-0' ]] && out+=" %B%F{yellow}⬇%f%b"
  fi
  (( staged ))    && out+=" %B%F{green}✚%f%b"
  (( deleted ))   && out+=" %B%F{red}✖%f%b"
  (( modified ))  && out+=" %B%F{blue}✱%f%b"
  (( renamed ))   && out+=" %B%F{magenta}➜%f%b"
  (( unmerged ))  && out+=" %B%F{yellow}═%f%b"
  (( untracked )) && out+=" %B%F{white}◼%f%b"
  [[ -n $stash ]] && out+=" %B%F{cyan}✭${stash}%f%b"

  _prompt_ismailp_git=$out
}

function prompt_ismailp_preexec {
  _prompt_ismailp_started=$EPOCHREALTIME
}

# Elapsed wall time of the last command, shown only past the threshold.
function prompt_ismailp_duration {
  _prompt_ismailp_duration=''
  (( _prompt_ismailp_started )) || return
  local -F elapsed=$(( EPOCHREALTIME - _prompt_ismailp_started ))
  _prompt_ismailp_started=0
  (( elapsed < _prompt_ismailp_min_duration )) && return
  local out
  if (( elapsed < 60 )); then
    out=$(( elapsed ))
    out="${out%.*}.${${out#*.}[1]}s"
  else
    local -i m=$(( elapsed / 60 )) s=$(( elapsed % 60 ))
    out="${m}m${s}s"
  fi
  _prompt_ismailp_duration=" %F{yellow}took ${out}%f"
}

function prompt_ismailp_precmd {
  setopt LOCAL_OPTIONS
  unsetopt XTRACE KSH_ARRAYS

  prompt_ismailp_duration
  prompt_ismailp_pwd
  prompt_ismailp_git

  if (( $+functions[python-info] )); then
    python-info
  fi
}

function prompt_ismailp_setup {
  setopt LOCAL_OPTIONS
  unsetopt XTRACE KSH_ARRAYS
  prompt_opts=(cr percent sp subst)

  zmodload zsh/datetime
  autoload -Uz add-zsh-hook
  add-zsh-hook precmd prompt_ismailp_precmd
  add-zsh-hook preexec prompt_ismailp_preexec

  zstyle ':prezto:module:prompt' managed 'yes'

  # Set editor-info parameters.
  zstyle ':prezto:module:editor:info:completing' format '%B%F{red}...%f%b'
  zstyle ':prezto:module:editor:info:keymap:primary' format ''
  zstyle ':prezto:module:editor:info:keymap:primary:overwrite' format ' %F{red}♺%f'
  zstyle ':prezto:module:editor:info:keymap:alternate' format ' %K{cyan}%F{black}N%f%k'
  zstyle ':prezto:module:syntax-highlighting' styles \
    'builtin' 'bg=white' \
    'command' 'bg=white'

  # Set python-info parameters.
  zstyle ':prezto:module:python:info:virtualenv' format '%f%F{3}(%v)%F{7} '

  _prompt_ismailp_pwd=''
  _prompt_ismailp_git=''
  _prompt_ismailp_gd=''
  _prompt_ismailp_duration=''
  _prompt_ismailp_started=0
  typeset -gF _prompt_ismailp_min_duration=2.0

  # Only worth the width when the box isn't this one.
  if [[ -n $SSH_CONNECTION || -n $SSH_CLIENT || -n $SSH_TTY ]]; then
    _prompt_ismailp_host='%F{72}%n%F{242}@%F{179}%m%f '
  else
    _prompt_ismailp_host=''
  fi

  # λ, but '#' when privileged -- that's the part of %# worth keeping.
  local char='%(?.%F{green}.%F{red})%(!.#.λ)%f'

  PROMPT='%b%f${_prompt_ismailp_host}%F{33}📁%f %F{209}${_prompt_ismailp_pwd}%f%b '$char'${editor_info[keymap]} '
  RPROMPT='%(1j;%F{cyan}%j⚙%f ;)${editor_info[overwrite]}%(?:: %F{red}⏎%?%f)${VIM:+" %B%F{green}V%f%b"}${_prompt_ismailp_git}${_prompt_ismailp_duration}'
  SPROMPT='zsh: correct %F{red}%R%f to %F{green}%r%f [nyae]? '
}

function prompt_ismailp_preview {
  local +h PROMPT=''
  local +h RPROMPT=''
  local +h SPROMPT=''

  editor-info 2> /dev/null
  prompt_preview_theme 'ismailp'
}

prompt_ismailp_setup "$@"
